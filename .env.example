# Project-wide examples only. Never place real keys in a tracked file.
# Copy to cloudbase/.env for local API and CloudBase integration.

# Local API
API_HOST=127.0.0.1
API_PORT=3000
PORT=3000
APP_ENV=local
SERVICE_VERSION=0.1.0
API_BASE_URL=http://127.0.0.1:3000
LIVE_API_BASE=

# Demo authentication and API tests
DEMO_USER_ID=usr_demo01
DEMO_AUTH_TOKEN=
TEST_USER_ID=usr_demo01
TEST_TOKEN=

# CloudBase private deployment settings
CLOUDBASE_ENV_ID=
STORAGE_API_BASE=
CLOUDBASE_API_KEY=
STORAGE_BUCKET=checkin-photos

# Android real-map integration. Leave empty to use the demo map.
AMAP_API_KEY=
